# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=valo-mapper

# Firebase Configuration
# Raw Firebase service account JSON (single-line string)
GOOGLE_APPLICATION_CREDENTIALS='{"type":"service_account",...}'

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Replay parser (VRFKit)
# Path to the pinned vrfkit binary; in Docker this is /usr/local/bin/vrfkit.
VRFKIT_BIN=vrfkit
# Upload cap in MiB. The handler streams to a temp file and hashes while reading.
REPLAY_MAX_UPLOAD_MB=250
# Per-process deadlines. The HTTP handler raises its own read/write deadlines
# to five minutes, so these guard the decoder subprocesses.
REPLAY_INSPECT_TIMEOUT=15s
REPLAY_EXPORT_TIMEOUT=3m
REPLAY_PARSE_TIMEOUT=3m
# How long a request may wait for a free parse slot before returning 503.
REPLAY_QUEUE_WAIT=30s
# One concurrent parse per 1 GB machine; raise only after measuring peak RSS.
REPLAY_MAX_CONCURRENT=1
# In-memory replay cache (parsed matches are never persisted to DB or S3).
REPLAY_CACHE_TTL=30m
REPLAY_CACHE_MAX_ENTRIES=8
REPLAY_CACHE_MAX_MB=64

# Riot Sign-On (RSO) OAuth Configuration
RSO_CLIENT_ID=rso-client-id
RSO_CLIENT_SECRET=rso-client-secret
RSO_REDIRECT_URI=http://localhost:3000/api/auth/rso/callback

# Riot Developer API key used for VAL-MATCH-V1 requests
RIOT_API_KEY=RGAPI-your-riot-developer-key

# Internal API key used by protected server-to-server endpoints
# Generate a high-entropy value and keep it secret
INTERNAL_API_KEY=your_internal_api_key

# Stripe API secret key and recurring price lookup keys for checkout sessions
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PRICE_LOOKUP_KEY_MONTHLY=standard_monthly
STRIPE_PRICE_LOOKUP_KEY_YEARLY=standard_yearly
STRIPE_PRICE_LOOKUP_KEY_STACK=standard_stack

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Redirect URLs after checkout
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel

# Tigris Object Storage
AWS_ACCESS_KEY_ID=tid_your_access_key_id
AWS_SECRET_ACCESS_KEY=tsec_your_secret_access_key
BUCKET_NAME=your-bucket-name
AWS_ENDPOINT_URL_S3=your_endpoint_url_s3
AWS_REGION=auto

# Log output format
# Options: json (default, structured — for Datadog/Loki), text (human-readable — for local dev)
LOG_FORMAT=text

# Swagger UI password (username is always "swagger").
# Set this to enable /swagger/ — if unset the endpoint returns 404.
# Use any high-entropy string; omit in production if you don't need docs exposed.
SWAGGER_PASSWORD=your_swagger_password